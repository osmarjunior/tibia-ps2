# --- Banco de dados ---
DB_ROOT_PASSWORD=othire
DB_PASSWORD=othire
DB_USER=othire
DB_NAME=othire

# --- Rede ---
# IP da máquina que roda o Docker, na rede do cliente (PS2).
# Descubra com: ip a  (Linux)  ou  ipconfig  (Windows)
SERVER_IP=192.168.0.10

# --- Contas ---
# Formato das senhas: plain (texto puro), md5 ou sha1
PASSWORD_TYPE=plain

# 1 = cria a conta 111111 (senha: tibia) e o personagem "Ps2 Tester"
SEED_TEST_DATA=1

# --- Build ---
# Commit/tag do OTHire (fixe um hash para builds reproduzíveis)
OTHIRE_REF=master